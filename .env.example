# Copy to .env (git-ignored) - the app loads it on startup.
# Variables already set in the environment take precedence.

# Authentication (single user). Both are required; the app denies all access if either is missing.
AUTH_USERNAME=
# bcrypt hash of the password - never put the plaintext password here.
# Generate with:
#   uv run python -c "import bcrypt, getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())"
# The hash contains '$' characters: keep it in single quotes, e.g. AUTH_PASSWORD_HASH='$2b$12$...'
AUTH_PASSWORD_HASH=''

# GitHub. Use a fine-grained token limited to the repository below.
# flaskehals-sync only needs read access to "Pull requests" and "Issues".
# flaskehals-label also adds/removes PR labels, which needs "Issues: Read and
# write" (consider a separate token so the sync stays read-only).
# The Tasks page's "Re-assign reviewer" button changes the reviewer: label with
# the same token and permission; without GITHUB_TOKEN the button is disabled.
# Re-assigning a task's developer likewise changes the dev: label of its open
# pull requests; without GITHUB_TOKEN only Neo4j is updated, with a notice.
GITHUB_TOKEN=
GITHUB_REPOSITORY=HastingsJack/Flaskehals

# Neo4j
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# OpenRouter. Required to generate task specifications. Also used to decide the
# recommended developer and reviewer; without a key the rule-based ranking is
# used instead.
# Note: ":free" models are heavily rate limited and their providers may log or
# train on prompts, so don't put sensitive project details in task descriptions.
OPENROUTER_API_KEY=
# Optional. Defaults to the value below.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional. Must be https. Defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=
