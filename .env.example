# Copy to .env (git-ignored) - the app loads it on startup.
# Variables already set in the environment take precedence.

# Authentication (single user). Both are required; the app denies all access if either is missing.
AUTH_USERNAME=
# bcrypt hash of the password - never put the plaintext password here.
# Generate with:
#   uv run python -c "import bcrypt, getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())"
# The hash contains '$' characters: keep it in single quotes, e.g. AUTH_PASSWORD_HASH='$2b$12$...'
AUTH_PASSWORD_HASH=''

# GitHub (read-only). Use a fine-grained token with read access to
# "Pull requests" and "Issues" on the repository below.
GITHUB_TOKEN=
GITHUB_REPOSITORY=HastingsJack/Flaskehals

# Neo4j
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Optional; leave empty for the server's default database.
NEO4J_DATABASE=

# Specification generation (OpenRouter). Required to generate task specifications.
# Note: ":free" models are heavily rate limited and their providers may log or
# train on prompts, so don't put sensitive project details in task descriptions.
OPENROUTER_API_KEY=
# Optional. Defaults to the value below.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional. Must be https. Defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=
